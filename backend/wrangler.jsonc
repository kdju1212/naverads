{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "naverads-api",
  "main": "src/main.py",
  "compatibility_date": "2026-10-18",
  "compatibility_flags": ["python_workers"],
  "observability": { "enabled": true },
  "triggers": { "crons": ["*/10 * * * *"] },
  // 요청 횟수 제한(src/main.py): IP당 1분 600번. 사무실 하나에서 여러 직원이 써도 걸리지 않게 넉넉히
  "ratelimits": [{ "name": "LIMITER", "namespace_id": "1001", "simple": { "limit": 600, "period": 60 } }],
  "d1_databases": [
    { "binding": "DB", "database_name": "naverads", "database_id": "f6603131-365a-425e-ae58-ed357b5f08b4", "migrations_dir": "migrations" }
  ]
}
